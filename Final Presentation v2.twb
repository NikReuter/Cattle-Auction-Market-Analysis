      <aliases enabled='yes' />
      <column caption='Giddings Highlight' datatype='string' name='[Calculation_1276599817195521]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF CONTAINS([Market Name], &quot;Giddings&quot;) THEN &quot;Giddings&quot; ELSE &quot;Other Markets&quot; END' />
      </column>
      <column caption='Cow Price vs Avg ' datatype='real' name='[Calculation_1276599839670275]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Wtd Avg Price] - { FIXED : AVG(IF [Partial Week]=&quot;No&quot; THEN [Wtd Avg Price] END) }' />
      </column>
      <column caption='Monthly Avg 400-600' datatype='real' name='[Calculation_1276599839961092]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='{ FIXED DATETRUNC(&apos;month&apos;,[Report Date]) : AVG([Feeder 400-600 Price]) }' />
      </column>
      <column caption='Is Annual Peak ' datatype='boolean' name='[Calculation_1276599840112645]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Feeder 400-600 Price] = { FIXED : MAX([Feeder 400-600 Price]) }' />
      </column>
      <column caption='Class Share of Head ' datatype='real' name='[Calculation_1276599840210950]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Head]) / MIN({ FIXED [Commodity],[Price Unit] : SUM([Head]) })' />
      </column>
      <column caption='Premium' datatype='real' name='[Calculation_1276600458088455]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='AVG([Feeder 400-600 Price])-AVG([Feeder 600-900 Price])' />
      </column>
      <column caption='Dumbell Start' datatype='real' name='[Calculation_1276600463331336]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF SUM([Feeder 400-600 Price]) &lt; SUM([Feeder 600-900 Price])&#13;&#10;THEN SUM([Feeder 400-600 Price])&#13;&#10;ELSE SUM([Feeder 600-900 Price])&#13;&#10;END' />
      </column>
      <column caption='Dumbell Length' datatype='real' name='[Calculation_1276600463433737]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='ABS(&#13;&#10;    SUM([Feeder 400-600 Price])&#13;&#10;    -&#13;&#10;    SUM([Feeder 600-900 Price])&#13;&#10;)' />
      </column>
      <column caption='Above cow price avg ' datatype='boolean' name='[Calculation_1276600868409354]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Calculation_1276599839670275] &gt;= 0' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Commodity]' role='dimension' type='nominal' />
      <column datatype='real' name='[Corn Avg Price]' role='measure' type='quantitative' />
      <column datatype='real' name='[Feeder 400-600 Price]' role='measure' type='quantitative' />
      <column datatype='real' name='[Feeder 600-900 Price]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Head Count]' role='measure' type='quantitative' />
      <column datatype='integer' name='[Head]' role='measure' type='quantitative' />
      <column aggregation='Avg' datatype='real' name='[Latitude]' role='measure' semantic-role='[Geographical].[Latitude]' type='quantitative' />
      <column aggregation='Avg' datatype='real' name='[Longitude]' role='measure' semantic-role='[Geographical].[Longitude]' type='quantitative' />
      <column datatype='string' name='[State]' role='dimension' semantic-role='[State].[Name]' type='nominal' />
